# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不会进入仓库。
# PowerContext Server 地址（scripts/run_powercontext.py 的默认监听地址）
SDDCTX_POWERCONTEXT_URL=http://127.0.0.1:8099

# MiniMax 开放平台凭据（Placeholder，请替换为真实值）
MINIMAX_API_KEY=sk-api-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_BASE_URL=https://api.minimax.chat/v1
# 国内区 api.minimax.chat 上可用 MiniMax-M1 / MiniMax-Text-01；
# 若账号已开通 M2.x 系列，可改为 MiniMax-M2.5 等（海外区端点为 https://api.minimaxi.chat/v1）
MINIMAX_MODEL=MiniMax-M1
MINIMAX_MAX_TOKENS=24000

# 上下文预算（字节），超过后按得分裁剪
SDDCTX_BUDGET_BYTES=24000
