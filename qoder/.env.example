# Copy to .env and edit as needed. Every value below is optional.

# Where uploaded files and the seekdb data directory live
PAPERDESK_DATA_DIR=./data

# local = bundled Chinese ONNX model, no API key needed
# api   = any OpenAI-compatible /embeddings endpoint
EMBEDDING_MODE=local
# EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=sk-xxxxxxxx
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIM=1024

# PowerContext server used for user preferences and search history
POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_TIMEOUT=5
PAPERDESK_MEMORY_ENABLED=true
