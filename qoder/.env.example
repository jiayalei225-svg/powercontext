# PaperDesk 服务端口
PAPERDESK_PORT=8080

# 数据目录（必须为纯 ASCII 路径；留空则使用项目内 data/）
PAPERDESK_DATA_DIR=

# 向量模型：local = 本地 BGE 中文小模型；api = OpenAI 兼容接口
EMBEDDING_MODE=local

# 仅 api 模式需要填写，请使用占位值，不要提交真实凭据
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# PowerContext 记忆服务
POWERCONTEXT_URL=http://127.0.0.1:18000
POWERCONTEXT_TIMEOUT=6
PAPERDESK_MEMORY_ENABLED=true
