# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8090
APP_STAGE=S2
USER_ID=local

# All relative paths are resolved from qoder/
DATA_DIR=./data
SEEKDB_PATH=./data/seekdb
MODEL_DIR=./data/models

# ---------------------------------------------------------------------------
# PowerContext (memory layer). Start it with scripts/start_powercontext.*
# ---------------------------------------------------------------------------
# A dedicated instance on 8010 keeps this project independent from any other
# PowerContext server you already run. Start it with scripts/start_powercontext.*
POWERCONTEXT_URL=http://127.0.0.1:8010
POWERCONTEXT_HOME=./data/powercontext
# Leave empty to let the app create and remember a "StudyCoach" scope on first use.
POWERCONTEXT_SCOPE_ID=
# PowerContext asks this app for embeddings; the app serves its local BGE model
# over POST /v1/embeddings so no external embedding key is required.
POWERCONTEXT_EMBEDDING_BASE_URL=http://127.0.0.1:8090/v1

# ---------------------------------------------------------------------------
# Embeddings
# local = Chinese BGE ONNX, cached under MODEL_DIR, no key required
# api   = any OpenAI-compatible /embeddings endpoint
# ---------------------------------------------------------------------------
EMBEDDING_MODE=local
EMBEDDING_MODEL=bge-small-zh-v1.5
EMBEDDING_HF_ID=Xenova/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
# Optional mirror for the first model download (leave empty to use huggingface.co)
HF_ENDPOINT=https://hf-mirror.com

# ---------------------------------------------------------------------------
# Hybrid retrieval
# ---------------------------------------------------------------------------
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_FTS_WEIGHT=0.4
HYBRID_TOP_K=10

# ---------------------------------------------------------------------------
# Mastery and review scheduling (S4)
# ---------------------------------------------------------------------------
MASTERY_ALPHA=0.25
MASTERY_BETA=0.20
DECAY_DAYS=14
DECAY_FACTOR=0.85

# ---------------------------------------------------------------------------
# Optional LLM (OpenAI-compatible). Leave empty to use evidence-only answers.
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
